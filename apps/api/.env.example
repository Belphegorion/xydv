# ==============================================================================
# XYDV API — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/xydv

# Authentication JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Razorpay Payment Gateway (INR)
RAZORPAY_KEY_ID=rzp_test_xydv_key
RAZORPAY_KEY_SECRET=xydv_test_secret
RAZORPAY_WEBHOOK_SECRET=xydv_webhook_secret

# Storefront Client Origin
CLIENT_URL=http://localhost:3000

# Cloudinary CDN Storage (Optional - falls back to local uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
