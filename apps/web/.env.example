# ==============================================================================
# XYDV STOREFRONT & ADMIN — CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as .env.local for local testing or production deployments.

# --- Backend API Endpoints ---
# Public browser-facing API endpoint (e.g. http://localhost:5000/api or /api on production Nginx)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Server-side internal API URL for Next.js SSR and API routes
INTERNAL_API_URL=http://localhost:5000/api

# --- Authentication (NextAuth v5 / Auth.js) ---
# Generate a secure 32-byte secret with: openssl rand -hex 32
AUTH_SECRET=generate-with-openssl-rand-hex-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payment Gateway (Razorpay INR) ---
# In development use rzp_test_* key. In production use rzp_live_* key from Razorpay Dashboard.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xydv_key

# --- Media Asset Storage (Cloudinary - Optional, falls back to local disk /uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
