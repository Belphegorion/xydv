# ==============================================================================
# XYDV MONOREPO — MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template documents all environment variables used across the XYDV platform:
# - apps/web: Next.js 15 Storefront & Admin Portal (.env.local)
# - apps/api: Express 5 REST API (.env)
#
# NEVER commit production .env or .env.local files containing live secrets to git.

# ==============================================================================
# 1. CLIENT / STOREFRONT (apps/web/.env.local)
# ==============================================================================

# --- Domain & Public URLs ---
NEXT_PUBLIC_SITE_URL=https://xydv-performance.com
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://localhost:5000/api

# --- Authentication (NextAuth v5 / Auth.js) ---
# Generate with: openssl rand -hex 32
NEXTAUTH_URL=https://xydv-performance.com
NEXTAUTH_SECRET=generate_a_secure_32_char_hex_secret_here
AUTH_SECRET=generate_a_secure_32_char_hex_secret_here
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payment Gateway (Razorpay Client Key - INR) ---
# Replace with your test (rzp_test_*) or live (rzp_live_*) Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xydv_key

# --- Media Asset Storage (Cloudinary - Optional, falls back to local disk /uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


# ==============================================================================
# 2. SERVER / REST API (apps/api/.env)
# ==============================================================================

PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/xydv?retryWrites=true&w=majority

# --- Authentication JWT Secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# --- Account Verification & Cryptographic Pepper (Workstream B) ---
# Pepper used to compute HMAC-SHA256 digests of 6-digit OTP codes.
# In production, this MUST be set to a dedicated random 64-character hex secret.
# Generate with: openssl rand -hex 32
OTP_PEPPER=<generate-with-openssl-rand-hex-32>

# --- Telemetry & Privacy Salt (Workstream A) ---
# Cryptographic salt for irreversible IP pseudonymization (SHA-256 truncated to 16 hex chars)
# Generate with: openssl rand -hex 16
IP_SALT=<generate-with-openssl-rand-hex-16>

# --- Payment Gateway (Razorpay Server Secrets) ---
# Development uses rzp_test_*; Production MUST use rzp_live_* keys.
RAZORPAY_KEY_ID=rzp_test_xydv_key
RAZORPAY_KEY_SECRET=xydv_test_secret
RAZORPAY_WEBHOOK_SECRET=xydv_webhook_secret

# --- Storefront Client Origin & Base API ---
CLIENT_URL=https://xydv-performance.com
API_URL=http://localhost:5000

# --- Transactional Notifications & SMS Delivery (Workstream B & C) ---
# AWS SES / SNS credentials for transactional order tracking updates and OTP verification
AWS_REGION=ap-south-1
SES_FROM_EMAIL=orders@xydv.com

# Telecom Regulatory Authority of India (TRAI) Distributed Ledger Technology (DLT) compliance
# Required for transactional SMS routing to Indian mobile operators (+91)
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=

# --- Media Asset Storage (Cloudinary - Optional, falls back to local disk uploads/) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=

# --- Operational Overrides & Seeding (Development only) ---
ADMIN_EMAIL=admin@xydv.com
ADMIN_PASSWORD=
ADMIN_NAME=XYDV System Administrator
DISABLE_RATE_LIMIT=false
