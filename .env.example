# ==============================================================================
# XYDV STOREFRONT — CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Duplicate this file as .env.local for local testing or add these variables
# directly into your Vercel Project Settings -> Environment Variables.

# --- Domain & Authentication ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate_a_secure_32_char_hex_secret_here

# --- Payment Gateway (Razorpay) ---
# Replace with your production or test Razorpay API keys from dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xydv_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# --- Optional Backend API (if connecting to external microservices) ---
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# --- Media Asset Storage (Cloudinary - Optional, falls back to local disk) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
